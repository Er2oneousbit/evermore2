[gd_resource type="GradientTexture2D" load_steps=2 format=3]

; Soft round drop shadow shared by every actor and prop. Scale the Sprite2D
; that uses it (e.g. scale = (0.75, 0.3)) to get a flat ellipse on the ground.
; 64x64, black, fully dark in the middle, fading out toward the edge.

